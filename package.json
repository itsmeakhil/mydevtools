{
  "name": "mydevtools-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @mydevtools/web dev",
    "dev:web": "pnpm --filter @mydevtools/web dev",
    "dev:backend": "pnpm --filter @mydevtools/backend dev",
    "build": "pnpm -r --if-present build",
    "start": "pnpm --filter @mydevtools/web start",
    "lint": "pnpm -r --if-present lint",
    "clean-install": "rimraf node_modules apps/*/node_modules && pnpm install"
  },
  "devDependencies": {
    "next": "16.0.10",
    "rimraf": "^6.1.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "next-themes@0.4.6": "patches/next-themes@0.4.6.patch"
    }
  }
}