#!/bin/sh
# MyDevTools Terminal status emitter: `mdt-hook <event>`. Runs inside Claude
# Code's hook path and the shell prompt, so it never prints to stdout and
# always exits 0 quickly.

[ -n "$MDT_HOOK_SOCKET" ] && [ -n "$MDT_HOOK_TOKEN" ] && [ -n "$MDT_TERMINAL_ID" ] || exit 0
event=$1
export LC_ALL=C # byte-wise tr/sed and ${#payload}

payload=
case $event in
  # Claude passes the hook input as one JSON object on stdin (JSON strings
  # never hold raw newlines, so stripping them keeps it valid).
  claude-*) payload=$(tr -d '\r\n' 2>/dev/null) ;;
  # `mdt-hook shell-<x> <pid> <seq>`: backgrounded events can arrive out of
  # order, so the app drops any seq not newer than the last one for that shell.
  shell-*)
    case $2$3 in
      '' | *[!0-9]*) ;;
      *) [ -n "$2" ] && [ -n "$3" ] && payload="{\"pid\":$2,\"seq\":$3}" ;;
    esac
    ;;
esac
# The app drops lines over 64 KiB (e.g. PreToolUse for a big Write); keep the event.
[ -n "$payload" ] && [ ${#payload} -le 60000 ] || payload='{}'

json_str() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

line=$(printf '{"token":"%s","terminal_id":"%s","event":"%s","payload":%s}' \
  "$(json_str "$MDT_HOOK_TOKEN")" "$(json_str "$MDT_TERMINAL_ID")" "$(json_str "$event")" "$payload")
# Synchronous so Claude's hooks arrive in order, but it must never linger: Claude
# waits on every hook. stdin is a here-doc, never a live pipe, so nc never sees
# it idle mid-line (bash's here-doc is a temp file; dash pre-fills small ones).
send() {
  nc "$@" -U "$MDT_HOOK_SOCKET" >/dev/null 2>&1 <<EOF
$line
EOF
}
if [ "$(uname)" = Darwin ]; then
  # macOS nc has no -N (its -N is something else) and only quits after -w
  # seconds idle; -w 0 quits at the first idle poll, once the line is written.
  send -w 0
else
  # OpenBSD nc: half-close on EOF, exit when the app closes (-w 1 caps it).
  # ncat rejects -N before connecting, so the fallback never sends twice.
  send -N -w 1 || send --send-only
fi
exit 0
